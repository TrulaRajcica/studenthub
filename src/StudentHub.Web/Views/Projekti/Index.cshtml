@model IEnumerable<StudentHub.Web.Models.Projekt>
@{
    ViewData["Title"] = "Projekti";
}

<div class="d-flex justify-content-between align-items-end mb-1">
    <div>
        <h1 class="mb-1">Projekti</h1>
        <p class="text-muted mb-0">Pregledaj radove drugih studenata i pronađi inspiraciju.</p>
    </div>
    <span class="text-muted small">@Model.Count() objavljenih projekata</span>
</div>

<hr class="mb-4" />

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5">
        <p class="mb-0 text-muted">Još nema objavljenih projekata.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var projekt in Model)
        {
            <div class="col">
<a asp-controller="Projekti" asp-action="Detalji" asp-route-id="@projekt.Id"
                   class="text-decoration-none text-reset">
                <div class="card h-100 shadow-sm card-projekt">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-secondary">@projekt.Kategorija?.Naziv</span>
                                @{
                                    var (oznaka, boja) = projekt.Status switch
                                    {
                                        StudentHub.Web.Models.StatusProjekta.Zavrsen   => ("Završen", "bg-success"),
                                        StudentHub.Web.Models.StatusProjekta.Arhiviran => ("Arhiviran", "bg-dark"),
                                        _                                              => ("U izradi", "bg-info text-dark")
                                    };
                                }
                                <span class="badge @boja">@oznaka</span>
                            </div>
                            @if (projekt.ProsjecnaOcjena.HasValue)
                            {
                                <span class="badge bg-warning text-dark">
                                    &#9733; @projekt.ProsjecnaOcjena.Value.ToString("0.0")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted">bez ocjena</span>
                            }
                        </div>

                        <h5 class="card-title">@projekt.Naziv</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(projekt.Opis.Length > 150 ? projekt.Opis[..150].TrimEnd() + "…" : projekt.Opis)
                        </p>

                        @if (projekt.Tagovi.Any())
                        {
                            <div class="mb-2">
                                @foreach (var pt in projekt.Tagovi)
                                {
                                    <span class="badge rounded-pill bg-light text-dark border me-1">@pt.Tag?.Naziv</span>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                            <small class="text-muted">@projekt.Vlasnik?.PunoIme</small>
                            <small class="text-muted">@projekt.BrojPregleda pregleda</small>
                        </div>
                    </div>
                </div>
                </a>
            </div>
        }
    </div>
}
