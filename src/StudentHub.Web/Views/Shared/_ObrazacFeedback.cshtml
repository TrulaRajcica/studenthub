@model StudentHub.Web.Models.ViewModels.FeedbackProjektaVm
@*
    TIM4-99 - obrazac za unos komentara i numericke ocjene.
    Prikazuje se samo kad korisnik stvarno smije ostaviti feedback;
    inace se ispisuje razlog (TIM4-100).
*@
@if (Model.SmijeOstaviti && Model.Obrazac is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 card-title mb-3">Ostavi komentar i ocjenu</h2>

            <form asp-controller="Feedback" asp-action="Objavi" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProjektId" value="@Model.Obrazac.ProjektId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <fieldset class="mb-3">
                    <legend class="form-label fs-6 mb-1">Ocjena</legend>
                    <div class="d-flex gap-3 flex-wrap">
                        @for (var i = 1; i <= 5; i++)
                        {
                            var id = $"ocjena-{i}";
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Ocjena" id="@id"
                                       value="@i" checked="@(Model.Obrazac.Ocjena == i)" required />
                                <label class="form-check-label" for="@id">
                                    @i <span class="text-warning" aria-hidden="true">★</span>
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>

                <div class="mb-3">
                    <label class="form-label" for="Komentar">Komentar</label>
                    <textarea class="form-control" id="Komentar" name="Komentar" rows="4"
                              maxlength="2000" required
                              placeholder="Sto ti se svidjelo, a sto bi autor mogao poboljsati?">@Model.Obrazac.Komentar</textarea>
                    <div class="form-text">Najvise 2000 znakova.</div>
                </div>

                <button type="submit" class="btn btn-primary">Objavi</button>
            </form>
        </div>
    </div>
}
else if (Model.RazlogBezObrasca is string razlog)
{
    <div class="alert alert-light border mb-4">@razlog</div>
}
