@model StudentHub.Web.Models.ViewModels.FeedbackProjektaVm
@*
    TIM4-103 - lista komentara, odgovori se prikazuju kad postoje.
    TIM4-104 - filtar po visini ocjene.
*@
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="h5 mb-0">
        Komentari
        <span class="text-muted fw-normal">(@Model.UkupnoKomentara)</span>
    </h2>

    <form asp-controller="Feedback" asp-action="Projekt" method="get"
          class="d-flex align-items-center gap-2">
        <input type="hidden" name="id" value="@Model.ProjektId" />
        <label class="form-label mb-0 small text-muted" for="filtar-ocjena">Ocjena</label>
        <select class="form-select form-select-sm w-auto" id="filtar-ocjena" name="ocjena"
                onchange="this.form.submit()">
            <option value="">sve</option>
            @for (var i = 5; i >= 1; i--)
            {
                <option value="@i" selected="@(Model.FiltarOcjena == i)">@i ★</option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Filtriraj</button></noscript>
    </form>
</div>

@if (Model.Komentari.Count == 0)
{
    <div class="alert alert-light border text-center py-4 mb-0">
        <p class="mb-0 text-muted">
            @(Model.FiltarOcjena.HasValue
                ? $"Nema komentara s ocjenom {Model.FiltarOcjena}."
                : "Ovaj projekt jos nema komentara. Budi prvi.")
        </p>
    </div>
}
else
{
    <ul class="list-unstyled mb-0">
        @foreach (var komentar in Model.Komentari)
        {
            <li class="border-top py-3">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <span class="fw-semibold">@(komentar.Autor?.PunoIme ?? "Nepoznat korisnik")</span>
                        <span class="text-warning ms-2" aria-hidden="true">
                            @for (var i = 1; i <= 5; i++)
                            {
                                @(i <= komentar.Ocjena ? "★" : "☆")
                            }
                        </span>
                        <span class="visually-hidden">Ocjena @komentar.Ocjena od 5.</span>
                    </div>
                    <time class="text-muted small text-nowrap"
                          datetime="@komentar.DatumKreiranja.ToString("o")">
                        @komentar.DatumKreiranja.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")
                    </time>
                </div>

                <p class="mb-0 mt-2">@komentar.Komentar</p>

                @if (komentar.Odgovori.Count > 0)
                {
                    <ul class="list-unstyled mt-3 ms-4 ps-3 border-start">
                        @foreach (var odgovor in komentar.Odgovori.OrderBy(o => o.DatumKreiranja))
                        {
                            <li class="mb-2">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <span class="fw-semibold small">@(odgovor.Autor?.PunoIme ?? "Nepoznat korisnik")</span>
                                    <time class="text-muted small text-nowrap"
                                          datetime="@odgovor.DatumKreiranja.ToString("o")">
                                        @odgovor.DatumKreiranja.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")
                                    </time>
                                </div>
                                <p class="mb-0 small">@odgovor.Tekst</p>
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
}
