# Kopiraj ovu datoteku u .env i popuni vrijednosti.
# .env se NIKAD ne commita — u repozitoriju stoji samo ovaj primjer.

# Baza podataka (SQLite, relativna putanja - ne mijenjaj bez dogovora)
ConnectionStrings__Default=Data Source=studenthub.db

# Port na kojem se aplikacija pokrece
ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development

# Slanje e-maila (potrebno tek od Sprinta 2, za sada ostavi prazno)
Email__SmtpHost=
Email__SmtpPort=
Email__Korisnik=
Email__Lozinka=
